{
  "name": "manga-reader-rust",
  "version": "1.0.0",
  "description": "MangaReader — Rust & Upscaler Edition",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cargo build --release",
    "build:ui": "vite build",
    "start": "cargo run --release",
    "typecheck": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "local.mangareader",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**",
      "electron/**"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
